{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battery passport (output of revive_ml.insight.passport)",
  "description": "Contract v1. Informational, not a regulatory document. Producer: engines/ml revive_ml/insight/passport.py (and insight.js passport in the web app).",
  "type": "object",
  "required": ["passport_version", "note", "asset_id", "chemistry", "soh", "gate", "decision", "top_reasons", "confidence", "provenance_summary", "engine", "generated_utc"],
  "properties": {
    "passport_version": {"type": "string"},
    "note": {"type": "string", "enum": ["informational, not a regulatory document"]},
    "asset_id": {"type": "string"},
    "chemistry": {"type": "string"},
    "rated_capacity_ah": {"type": ["number", "null"]},
    "nominal_voltage_v": {"type": ["number", "null"]},
    "cycle_count": {"type": ["integer", "number", "null"]},
    "soh": {"type": "object", "required": ["value", "provenance"]},
    "rul_cycles": {"type": ["object", "null"]},
    "gate": {"type": ["string", "null"]},
    "decision": {"type": "string"},
    "disposition": {"type": ["object", "null"]},
    "top_reasons": {"type": "array", "items": {"type": "object", "required": ["title", "text", "tone"]}},
    "confidence": {"type": "object", "required": ["level", "score_0_100", "label"]},
    "provenance_summary": {"type": "object", "required": ["data"]},
    "engine": {"type": "object", "required": ["name", "version"]},
    "input_telemetry_sha256": {"type": ["string", "null"]},
    "generated_utc": {"type": "string"},
    "net_value_usd": {"type": ["number", "null"]}
  },
  "additionalProperties": true
}
